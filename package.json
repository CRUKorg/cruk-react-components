{
  "name": "@cruk/cruk-react-components",
  "version": "7.2.11",
  "description": "React components implementing CRUK, RFL, SU2C & Bowelbabe designs",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "module": "lib/src/components/index.js",
  "jsnext:main": "lib/src/components/index.js",
  "types": "lib/src/components/index.d.ts",
  "sideEffects": false,
  "files": [
    "lib",
    "lib/index.css"
  ],
  "scripts": {
    "test-ct": "playwright test -c playwright.config.ts",
    "test-ct:debug": "playwright test -c playwright.config.ts --debug --project=chromium",
    "test-ct:ui": "playwright test -c playwright.config.ts --ui",
    "node-test": " node --import tsx --test-reporter=spec --test src/utils/__tests__/testHelpers.test.ts",
    "node-test-watch": "node --import tsx --test-reporter=spec --watch --test src/utils/__tests__/testHelpers.test.ts",
    "test": "npm run node-test && npm run test-ct",
    "release": "release-it",
    "clean-lib": "rm -rf ./lib",
    "dev": "vite",
    "rollup:build-lib": "npm run clean-lib && rollup --config",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "format": "oxfmt --check src",
    "format:fix": "oxfmt --write src",
    "chromatic": "chromatic --exit-zero-on-changes"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/CRUKorg/cruk-react-components.git"
  },
  "bugs": {
    "url": "https://github.com/CRUKorg/cruk-react-components/issues"
  },
  "homepage": "https://github.com/CRUKorg/cruk-react-components#readme",
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@chromatic-com/storybook": "^5.3.0",
    "@playwright/test": "^1.62.1",
    "@rollup/plugin-commonjs": "^29.0.0",
    "@rollup/plugin-node-resolve": "^16.0.3",
    "@rollup/plugin-terser": "^1.0.0",
    "@rollup/plugin-typescript": "^12.0.0",
    "@storybook/addon-a11y": "^10.5.10",
    "@storybook/addon-docs": "^10.5.10",
    "@storybook/addon-links": "^10.5.10",
    "@storybook/react-vite": "^10.5.10",
    "@swc/core": "1.15.43",
    "@types/assert": "^1.5.1",
    "@types/node": "^24",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react-swc": "^4.2.3",
    "autoprefixer": "^10.4.22",
    "chromatic": "^18.1.0",
    "oxfmt": "^0.65.0",
    "oxlint": "^1.80.0",
    "react": "^19",
    "react-dom": "^19",
    "release-it": "^21.0.1",
    "rollup": "^4.22.4",
    "rollup-plugin-postcss": "^4.0.2",
    "storybook": "^10.5.10",
    "tsx": "^4.20.3",
    "typescript": "^5.7.3",
    "typescript-plugin-css-modules": "^5.2.0",
    "vite": "^8"
  },
  "peerDependencies": {
    "react": "^19",
    "react-dom": "^19"
  },
  "dependencies": {
    "@fortawesome/fontawesome-common-types": "^7",
    "@fortawesome/free-brands-svg-icons": "^7",
    "@fortawesome/free-solid-svg-icons": "^7"
  }
}
